# Optional local overrides. Defaults work without creating an .env file.
# Role provisioning and upgrades of existing volumes: see DATABASE.md.
API_PORT=8000
LEASE_SECONDS=15
HEARTBEAT_SECONDS=3
MAX_ATTEMPTS=5
POLL_SECONDS=0.1
SIMULATION_SECONDS=0.1
MAX_OUTSTANDING_JOBS=1000
DB_POOL_ENABLED=1
DB_POOL_SIZE=4
DB_POOL_TIMEOUT=1
WORKER_REPLICAS=16
# File ownership for the optional chaos service; match the host account.
LOCAL_UID=1000
LOCAL_GID=1000
