{
  "name": "soup-review-006",
  "networks": {
    "default": {
      "name": "soup-review-006_default",
      "ipam": {}
    }
  },
  "services": {
    "api": {
      "build": {
        "context": "/home/paprojky/Music/soup_test/training-job-queue",
        "dockerfile": "Dockerfile"
      },
      "command": null,
      "depends_on": {
        "migrate": {
          "condition": "service_completed_successfully",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "DATABASE_URL": "postgresql://queue_runtime:queue_runtime@db:5432/queue",
        "DB_POOL_ENABLED": "1",
        "DB_POOL_SIZE": "4",
        "DB_POOL_TIMEOUT": "1",
        "HEARTBEAT_SECONDS": "3",
        "LEASE_SECONDS": "15",
        "MAX_ATTEMPTS": "5",
        "MAX_OUTSTANDING_JOBS": "1000",
        "POLL_SECONDS": "0.1",
        "SIMULATION_SECONDS": "0.1"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=4)"
        ],
        "timeout": "5s",
        "interval": "5s",
        "retries": 10
      },
      "image": "training-job-queue:review-006-poll",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 8000,
          "published": "18086",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped"
    },
    "db": {
      "command": null,
      "entrypoint": null,
      "environment": {
        "POSTGRES_DB": "queue",
        "POSTGRES_PASSWORD": "queue_admin",
        "POSTGRES_USER": "queue_admin"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -h 127.0.0.1 -U queue_runtime -d queue"
        ],
        "timeout": "3s",
        "interval": "2s",
        "retries": 20
      },
      "image": "postgres:16-alpine",
      "networks": {
        "default": null
      },
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "volume",
          "source": "postgres-data",
          "target": "/var/lib/postgresql/data",
          "volume": {}
        },
        {
          "type": "bind",
          "source": "/home/paprojky/Music/soup_test/training-job-queue/docker/postgres/001-roles.sql",
          "target": "/docker-entrypoint-initdb.d/001-roles.sql",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        }
      ]
    },
    "migrate": {
      "build": {
        "context": "/home/paprojky/Music/soup_test/training-job-queue",
        "dockerfile": "Dockerfile"
      },
      "command": [
        "sh",
        "-c",
        "python -m training_job_queue.migrate \u0026\u0026 python -m training_job_queue.permissions"
      ],
      "depends_on": {
        "db": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "DATABASE_URL": "postgresql://queue_migrator:queue_migrator@db:5432/queue"
      },
      "image": "training-job-queue:review-006-poll",
      "networks": {
        "default": null
      },
      "restart": "no"
    },
    "worker": {
      "build": {
        "context": "/home/paprojky/Music/soup_test/training-job-queue",
        "dockerfile": "Dockerfile"
      },
      "command": [
        "python",
        "-m",
        "training_job_queue.worker"
      ],
      "depends_on": {
        "migrate": {
          "condition": "service_completed_successfully",
          "required": true
        }
      },
      "deploy": {
        "replicas": 16,
        "resources": {},
        "placement": {}
      },
      "entrypoint": null,
      "environment": {
        "DATABASE_URL": "postgresql://queue_runtime:queue_runtime@db:5432/queue",
        "DB_POOL_ENABLED": "1",
        "DB_POOL_SIZE": "4",
        "DB_POOL_TIMEOUT": "1",
        "HEARTBEAT_SECONDS": "3",
        "LEASE_SECONDS": "15",
        "MAX_ATTEMPTS": "5",
        "MAX_OUTSTANDING_JOBS": "1000",
        "POLL_SECONDS": "0.1",
        "SIMULATION_SECONDS": "0.1"
      },
      "image": "training-job-queue:review-006-poll",
      "networks": {
        "default": null
      },
      "restart": "unless-stopped"
    }
  },
  "volumes": {
    "postgres-data": {
      "name": "soup-review-006_postgres-data"
    }
  },
  "x-app": {
    "build": ".",
    "environment": {
      "DATABASE_URL": "postgresql://queue_runtime:queue_runtime@db:5432/queue",
      "DB_POOL_ENABLED": "1",
      "DB_POOL_SIZE": "4",
      "DB_POOL_TIMEOUT": "1",
      "HEARTBEAT_SECONDS": "3",
      "LEASE_SECONDS": "15",
      "MAX_ATTEMPTS": "5",
      "MAX_OUTSTANDING_JOBS": "1000",
      "POLL_SECONDS": "0.1",
      "SIMULATION_SECONDS": "0.1"
    },
    "image": "training-job-queue:local"
  }
}